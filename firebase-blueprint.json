{
  "entities": {
    "User": {
      "title": "User",
      "description": "Application user profile, role, and approval status.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "role": { "type": "string", "enum": ["CUSTOMER", "ADMIN", "SUPER_ADMIN"] },
        "accountStatus": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED", "SUSPENDED"] },
        "permissions": { "type": "array", "description": "Granular permissions assigned to ADMIN accounts by SUPER_ADMIN." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "approvedAt": { "type": "string", "format": "date-time" },
        "approvedBy": { "type": "string", "maxLength": 128 },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "themePreference": { "type": "string", "enum": ["light", "dark", "system"] }
      },
      "required": ["uid", "displayName", "email", "role", "accountStatus", "createdAt", "updatedAt", "themePreference"]
    },
    "Project": {
      "title": "Project",
      "description": "Customer video clipping project metadata.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "sourceVideoId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["DRAFT", "PROCESSING", "READY", "ARCHIVED", "FAILED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "ownerId", "projectName", "status", "createdAt", "updatedAt"]
    },
    "SourceVideo": {
      "title": "SourceVideo",
      "description": "Uploaded or imported source video metadata.",
      "type": "object",
      "properties": {
        "videoId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 255 },
        "storagePath": { "type": "string", "maxLength": 1024 },
        "duration": { "type": "number" },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "frameRate": { "type": "number" },
        "fileSize": { "type": "integer" },
        "mimeType": { "type": "string", "maxLength": 120 },
        "processingStatus": { "type": "string", "enum": ["LOCAL_READY", "UPLOADING", "STORED", "FAILED"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["videoId", "ownerId", "projectId", "fileName", "storagePath", "duration", "width", "height", "frameRate", "fileSize", "mimeType", "processingStatus", "createdAt"]
    },
    "ProcessingJob": {
      "title": "ProcessingJob",
      "description": "Video analysis, AI clipping, and rendering pipeline job state.",
      "type": "object",
      "properties": {
        "jobId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sourceVideoId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["QUEUED", "VALIDATING", "TRANSCRIBING", "ANALYZING", "SELECTING_CLIPS", "RENDERING", "QUALITY_CHECK", "COMPLETED", "FAILED", "CANCELLED"] },
        "progress": { "type": "integer" },
        "currentStage": { "type": "string", "maxLength": 200 },
        "errorMessage": { "type": "string", "maxLength": 1000 },
        "executionMode": { "type": "string", "enum": ["BROWSER_LOCAL", "HYBRID_CLOUD"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["jobId", "ownerId", "projectId", "sourceVideoId", "status", "progress", "currentStage", "executionMode", "createdAt", "updatedAt"]
    },
    "Clip": {
      "title": "Clip",
      "description": "AI-selected or user-edited short-form video clip metadata.",
      "type": "object",
      "properties": {
        "clipId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sourceVideoId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "startTime": { "type": "number" },
        "endTime": { "type": "number" },
        "duration": { "type": "number" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1200 },
        "hook": { "type": "string", "maxLength": 400 },
        "topic": { "type": "string", "maxLength": 120 },
        "reason": { "type": "string", "maxLength": 800 },
        "score": { "type": "integer" },
        "clipStoragePath": { "type": "string", "maxLength": 1024 },
        "aspectRatio": { "type": "string", "enum": ["9:16", "16:9", "1:1"] },
        "status": { "type": "string", "enum": ["CANDIDATE", "EDITING", "RENDERED", "EXPORTED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clipId", "ownerId", "projectId", "sourceVideoId", "startTime", "endTime", "duration", "title", "description", "score", "clipStoragePath", "aspectRatio", "status", "createdAt", "updatedAt"]
    },
    "Transcript": {
      "title": "Transcript",
      "description": "Timestamped speech transcript for a source video.",
      "type": "object",
      "properties": {
        "transcriptId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sourceVideoId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "language": { "type": "string", "maxLength": 32 },
        "transcriptText": { "type": "string", "maxLength": 200000 },
        "timestampGranularity": { "type": "string", "enum": ["WORD", "SEGMENT", "MANUAL"] },
        "timestampedSegments": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["transcriptId", "ownerId", "projectId", "sourceVideoId", "language", "transcriptText", "timestampGranularity", "timestampedSegments", "createdAt"]
    },
    "ExportRecord": {
      "title": "ExportRecord",
      "description": "Rendered video export record.",
      "type": "object",
      "properties": {
        "exportId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clipId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "format": { "type": "string", "enum": ["MP4"] },
        "resolution": { "type": "string", "enum": ["720p", "1080p"] },
        "aspectRatio": { "type": "string", "enum": ["9:16", "16:9", "1:1"] },
        "storagePath": { "type": "string", "maxLength": 1024 },
        "fileSize": { "type": "integer" },
        "status": { "type": "string", "enum": ["RENDERING", "COMPLETED", "FAILED"] },
        "errorMessage": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["exportId", "ownerId", "clipId", "format", "resolution", "aspectRatio", "storagePath", "fileSize", "status", "createdAt"]
    },
    "BrandKit": {
      "title": "BrandKit",
      "description": "Customer reusable brand preset for captions and watermarks.",
      "type": "object",
      "properties": {
        "brandKitId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "logoPath": { "type": "string", "maxLength": 1024 },
        "primaryColor": { "type": "string", "maxLength": 32 },
        "secondaryColor": { "type": "string", "maxLength": 32 },
        "captionSettings": { "type": "object" },
        "watermarkSettings": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["brandKitId", "ownerId", "name", "logoPath", "primaryColor", "secondaryColor", "captionSettings", "watermarkSettings", "createdAt", "updatedAt"]
    },
    "UsageRecord": {
      "title": "UsageRecord",
      "description": "Customer usage tracking record for quota enforcement.",
      "type": "object",
      "properties": {
        "recordId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "operation": { "type": "string", "maxLength": 80 },
        "resourceType": { "type": "string", "enum": ["AI_REQUEST", "VIDEO_UPLOAD", "CLIP_RENDER", "EXPORT", "STORAGE_BYTES"] },
        "resourceAmount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recordId", "ownerId", "operation", "resourceType", "resourceAmount", "createdAt"]
    },
    "SystemSetting": {
      "title": "SystemSetting",
      "description": "Platform configuration, limits, and AI settings.",
      "type": "object",
      "properties": {
        "settingId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "settingValue": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["settingId", "settingValue", "updatedAt", "updatedBy"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security and administration audit log entry.",
      "type": "object",
      "properties": {
        "logId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "action": { "type": "string", "minLength": 1, "maxLength": 120 },
        "targetId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      },
      "required": ["logId", "actorId", "action", "targetId", "timestamp", "metadata"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app user notification.",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["ACCOUNT_STATUS", "VIDEO_UPLOAD", "AI_ANALYSIS", "CLIPS_GENERATED", "EXPORT_COMPLETED", "PROCESSING_FAILED"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "message": { "type": "string", "maxLength": 500 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["notificationId", "ownerId", "type", "title", "message", "read", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles, roles, and approval statuses."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Customer video clipping projects."
    },
    "/sourceVideos/{videoId}": {
      "schema": { "$ref": "#/entities/SourceVideo" },
      "description": "Source video metadata records."
    },
    "/processingJobs/{jobId}": {
      "schema": { "$ref": "#/entities/ProcessingJob" },
      "description": "Video analysis and rendering job records."
    },
    "/clips/{clipId}": {
      "schema": { "$ref": "#/entities/Clip" },
      "description": "Generated and edited short-form clip metadata."
    },
    "/transcripts/{transcriptId}": {
      "schema": { "$ref": "#/entities/Transcript" },
      "description": "Timestamped speech transcripts."
    },
    "/exports/{exportId}": {
      "schema": { "$ref": "#/entities/ExportRecord" },
      "description": "Completed and failed video export records."
    },
    "/brandKits/{brandKitId}": {
      "schema": { "$ref": "#/entities/BrandKit" },
      "description": "Reusable brand kits."
    },
    "/usageRecords/{recordId}": {
      "schema": { "$ref": "#/entities/UsageRecord" },
      "description": "Resource usage ledger for quota enforcement."
    },
    "/systemSettings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSetting" },
      "description": "Platform limits and AI configuration."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable administrative audit logs."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "In-app user notifications."
    }
  }
}
